# EVENTS – Environment Configuration
# Copy this file to .env and fill in your actual keys
# NEVER commit .env with real keys to version control

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_string_in_production
FLASK_ENV=production
FLASK_DEBUG=0

# ── Real Email OTP Delivery (Gmail SMTP / Custom SMTP) ────────────────────────
# Use your Gmail address and a 16-character Google App Password
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=yourname@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=EVENTS Verification

# ── Real Mobile SMS OTP Delivery (Fast2SMS / Twilio) ──────────────────────────
# Option A: Fast2SMS (Indian SMS Gateway: https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio (Global SMS Gateway: https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── OpenAI (for AI Chatbot) ───────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Leave blank to use smart fallback mode (no API required)
OPENAI_API_KEY=

# ── Razorpay (for Payments) ───────────────────────────────────────────────────
# Test mode keys from: https://dashboard.razorpay.com/app/keys
# Keys starting with rzp_test_ are safe for development
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
